<Window x:Class="SecurePrintManager.UI.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <TabControl>
            <!-- Users tab -->
            <TabItem Header="Users">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="UsersDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username"
                                                Binding="{Binding Username}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Full name"
                                                Binding="{Binding FullName}"
                                                Width="200"/>
                            <DataGridTextColumn Header="PIN"
                                                Binding="{Binding PinCode}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Card"
                                                Binding="{Binding CardCode}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Quota"
                                                Binding="{Binding MonthlyQuota}"
                                                Width="80"/>
                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive}"
                                                    Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Add"
                                Click="AddUser_Click"
                                Margin="5" Padding="10,2"/>
                        <Button Content="Edit"
                                Click="EditUser_Click"
                                Margin="5" Padding="10,2"/>
                        <Button Content="Delete"
                                Click="DeleteUser_Click"
                                Margin="5" Padding="10,2"/>
                        <Button Content="Import CSV"
                                Click="ImportCsv_Click"
                                Margin="5" Padding="10,2"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Settings tab -->
            <TabItem Header="Settings">
                <StackPanel Margin="10" Width="300">
                    <TextBlock Text="Job timeout (hours)"/>
                    <TextBox x:Name="JobTimeoutTextBox" Margin="0,0,0,10"/>

                    <TextBlock Text="Session timeout (minutes)"/>
                    <TextBox x:Name="SessionTimeoutTextBox" Margin="0,0,0,10"/>

                    <TextBlock Text="Cost B&amp;W (RON/page)"/>
                    <TextBox x:Name="CostBwTextBox" Margin="0,0,0,10"/>

                    <TextBlock Text="Cost Color (RON/page)"/>
                    <TextBox x:Name="CostColorTextBox" Margin="0,0,0,10"/>

                    <TextBlock Text="Cost Scan (RON/scan)"/>
                    <TextBox x:Name="CostScanTextBox" Margin="0,0,0,10"/>

                    <CheckBox x:Name="EnableEncryptionCheckBox"
                              Content="Enable encryption"
                              Margin="0,0,0,5"/>
                    <CheckBox x:Name="EnableAuditLogCheckBox"
                              Content="Enable audit log"
                              Margin="0,0,0,15"/>

                    <Button Content="Save settings"
                            Click="SaveSettings_Click"
                            Width="150"/>
                </StackPanel>
            </TabItem>

            <!-- Printers tab (placeholder) -->
            <TabItem Header="Printers">
                <TextBlock Text="Printers management to be implemented."
                           Margin="10"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
