<Window x:Class="SecurePrintManager.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Print Manager - Autentificare"
        Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Border CornerRadius="12" Background="#1E293B" Padding="20" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="SecurePrint Manager" 
                           FontSize="26" 
                           FontWeight="Bold"
                           Foreground="#38BDF8"/>
                <TextBlock Text="Autentificare utilizator" 
                           FontSize="14"
                           Foreground="#9CA3AF"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Tabs -->
            <TabControl Grid.Row="1" Margin="0" Background="#0F172A">
                <!-- PIN Tab -->
                <TabItem Header="PIN" Foreground="White">
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="Cod PIN" 
                                   FontSize="14"
                                   Foreground="#E5E7EB"
                                   Margin="0,0,0,10"/>
                        <PasswordBox x:Name="PinPasswordBox" 
                                     MaxLength="6"
                                     FontSize="20"
                                     HorizontalAlignment="Stretch"
                                     Padding="10"
                                     Background="#020617"
                                     Foreground="#F9FAFB"
                                     BorderBrush="#38BDF8"/>
                        <Button Content="Login" 
                                Click="LoginByPin_Click"
                                Margin="0,20,0,0"
                                Height="36"
                                Background="#38BDF8"
                                Foreground="#0F172A"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem>

                <!-- Card Tab -->
                <TabItem Header="Card NFC" Foreground="White">
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="Apropie cardul de cititor" 
                                   FontSize="14"
                                   Foreground="#E5E7EB"
                                   Margin="0,0,0,10"/>
                        <Ellipse Width="90" Height="90" 
                                 Fill="#1F2937"
                                 Margin="0,0,0,15">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#38BDF8" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="CardStatusText" 
                                   Text="Așteptare card..." 
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   FontSize="12"/>
                        <TextBlock x:Name="CardCodeText" 
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#38BDF8"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Închide" 
                        Click="Cancel_Click"
                        Width="90"
                        Height="32"
                        Background="#111827"
                        Foreground="#E5E7EB"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
