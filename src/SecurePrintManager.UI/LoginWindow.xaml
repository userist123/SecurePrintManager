<Window x:Class="SecurePrintManager.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Print Manager - Autentificare"
        Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
            <TextBlock Text="🔐 Secure Print Manager" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="#2563EB"/>
            <TextBlock Text="Autentificare" 
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="0,0,0,20">
            <!-- PIN Tab -->
            <TabItem Header="📱 PIN">
                <StackPanel Margin="15" VerticalAlignment="Center">
                    <TextBlock Text="Introduce cod PIN:" 
                               FontSize="14"
                               Margin="0,0,0,10"/>
                    <PasswordBox x:Name="PinPasswordBox" 
                                 MaxLength="6"
                                 FontSize="20"
                                 HorizontalAlignment="Center"
                                 Width="180"
                                 Padding="10"/>
                    <Button Content="Login" 
                            Click="LoginByPin_Click"
                            Width="120"
                            Margin="0,20,0,0"
                            Background="#2563EB"
                            Foreground="White"/>
                </StackPanel>
            </TabItem>
            
            <!-- Card Tab -->
            <TabItem Header="💳 Card NFC">
                <StackPanel Margin="15" VerticalAlignment="Center">
                    <TextBlock Text="Apropie cardul de cititor:" 
                               FontSize="14"
                               Margin="0,0,0,10"/>
                    <Ellipse Width="80" Height="80" 
                             Fill="#E5E7EB"
                             Margin="0,0,0,15">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.3" To="1"
                                                     Duration="0:0:1"
                                                     AutoReverse="True"
                                                     RepeatBehavior="Forever"/>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="CardStatusText" 
                               Text="Așteptare card..." 
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                    <TextBlock x:Name="CardCodeText" 
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#2563EB"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        
        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Login" 
                    Click="LoginByPin_Click"
                    Width="100"
                    Margin="0,0,10,0"
                    Background="#2563EB"
                    Foreground="White"/>
            <Button Content="Cancel" 
                    Click="Cancel_Click"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>