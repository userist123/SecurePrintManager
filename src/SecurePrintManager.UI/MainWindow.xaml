<Window x:Class="SecurePrintManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecurePrint Manager"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#020617">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Background="#0F172A" Height="46">
            <TextBlock Text="SecurePrint Manager"
                       Foreground="#F9FAFB"
                       FontWeight="Bold"
                       Margin="12,0"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,0">
                <Button Content="Print Queue" Click="PrintQueueButton_Click" Margin="4" Padding="12,4" Background="#111827" Foreground="#E5E7EB"/>
                <Button Content="History" Click="HistoryButton_Click" Margin="4" Padding="12,4" Background="#111827" Foreground="#E5E7EB"/>
                <Button Content="Reports" Click="ReportsButton_Click" Margin="4" Padding="12,4" Background="#111827" Foreground="#E5E7EB"/>
                <Button Content="Admin" Click="AdminButton_Click" Margin="4" Padding="12,4" Background="#111827" Foreground="#E5E7EB"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Queue + preview -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <!-- Secure Print Queue -->
                <Border CornerRadius="8" Background="#020617" BorderBrush="#1F2937" BorderThickness="1" Padding="8" Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Secure Print Queue" Foreground="#E5E7EB" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="PrintQueueDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="#020617"
                                  Foreground="#F9FAFB"
                                  GridLinesVisibility="None"
                                  SelectionChanged="PrintQueueDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" Width="*"/>
                                <DataGridTextColumn Header="Pagini" Binding="{Binding Pages}" Width="80"/>
                                <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="150"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Print" Click="PrintSelectedJob_Click" Margin="4" Width="90"/>
                            <Button Content="Delete" Click="DeleteSelectedJob_Click" Margin="4" Width="90"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Preview pane (PDF/Image) -->
                <Border CornerRadius="8" Background="#020617" BorderBrush="#1F2937" BorderThickness="1" Padding="8" Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Preview document" Foreground="#E5E7EB" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <!-- Placeholder: poți integra un PDF viewer (ex: WebBrowser sau control 3rd party) -->
                        <Border Background="#0F172A" CornerRadius="6" Height="260" Margin="0,0,0,8">
                            <TextBlock x:Name="PreviewInfoText"
                                       Text="Selectează un job pentru a vedea detalii (PDF/imagine)."
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="PreviewMetaText" Foreground="#9CA3AF" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: User info + stats -->
            <StackPanel Grid.Column="1">
                <Border CornerRadius="8" Background="#020617" BorderBrush="#1F2937" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="UserNameText" FontSize="16" FontWeight="Bold" Foreground="#F9FAFB"/>
                        <TextBlock x:Name="DepartmentText" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                        <TextBlock x:Name="QuotaText" Foreground="#E5E7EB" Margin="0,4,0,2"/>
                        <ProgressBar x:Name="QuotaProgressBar" Height="18" Minimum="0" Maximum="100" Margin="0,2,0,4"/>
                        <TextBlock x:Name="LastLoginText" Foreground="#9CA3AF" Margin="0,4,0,2"/>
                        <TextBlock x:Name="PagesUsedText" Foreground="#9CA3AF" Margin="0,2,0,2"/>
                        <TextBlock x:Name="ScansUsedText" Foreground="#9CA3AF" Margin="0,2,0,2"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Background="#020617" BorderBrush="#1F2937" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Daily activity" Foreground="#E5E7EB" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <!-- Placeholder pentru mini-grafice (ex: text summary sau integrare ulterior cu control grafic) -->
                        <TextBlock x:Name="DailyActivityText" Foreground="#9CA3AF" Text="Printuri/scanneri azi: TBD"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Background="#0F172A">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#9CA3AF"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
