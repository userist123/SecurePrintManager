<Window x:Class="SecurePrintManager.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Istoric Print/Scan"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <GroupBox Header="Filtre" Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="De la:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="FromDatePicker"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Pănă la:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="ToDatePicker"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Tip:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="TypeComboBox" SelectionChanged="TypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Toate" IsSelected="True"/>
                        <ComboBoxItem Content="Print"/>
                        <ComboBoxItem Content="Scan"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5" VerticalAlignment="Bottom">
                    <Button Content="Filtrează" Click="FilterButton_Click" Width="100" Margin="0,0,5,0"/>
                    <Button Content="Reset" Click="ResetButton_Click" Width="100"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Data -->
        <DataGrid x:Name="HistoryDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dată/Ora" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="60"/>
                <DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" Width="*"/>
                <DataGridTextColumn Header="Pagini" Binding="{Binding Pages}" Width="80"/>
                <DataGridTextColumn Header="Printer/Destinație" Binding="{Binding Destination}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat={}{0:0.00} RON}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Export CSV" Click="ExportCsvButton_Click" Width="100" Margin="0,0,5,0"/>
            <Button Content="Î«chide" Click="CloseButton_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>